{
  "cluster": "gazelle",
  "namespace": "org-giantswarm",
  "mode": "apply",
  "dryRun": true,
  "objects": [
    {
      "apiVersion": "source.toolkit.fluxcd.io/v1",
      "kind": "OCIRepository",
      "name": "gazelle-agent-platform",
      "namespace": "org-giantswarm",
      "action": "unchanged"
    },
    {
      "apiVersion": "helm.toolkit.fluxcd.io/v2",
      "kind": "HelmRelease",
      "name": "gazelle-agent-platform",
      "namespace": "org-giantswarm",
      "action": "would-update",
      "changes": [
        "spec.values.modelServing.cache.enabled"
      ]
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "name": "hf-cache",
      "namespace": "model-serving",
      "action": "would-delete"
    }
  ],
  "manifests": [
    {
      "apiVersion": "source.toolkit.fluxcd.io/v1",
      "kind": "OCIRepository",
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "cluster-manager",
          "app.kubernetes.io/name": "agent-platform",
          "giantswarm.io/cluster": "gazelle"
        },
        "name": "gazelle-agent-platform",
        "namespace": "org-giantswarm"
      },
      "spec": {
        "interval": "10m",
        "ref": {
          "tag": "4.44.1"
        },
        "url": "oci://gsoci.azurecr.io/charts/giantswarm/agent-platform"
      }
    },
    {
      "apiVersion": "helm.toolkit.fluxcd.io/v2",
      "kind": "HelmRelease",
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "cluster-manager",
          "app.kubernetes.io/name": "agent-platform",
          "giantswarm.io/cluster": "gazelle"
        },
        "name": "gazelle-agent-platform",
        "namespace": "org-giantswarm"
      },
      "spec": {
        "chartRef": {
          "kind": "OCIRepository",
          "name": "gazelle-agent-platform"
        },
        "install": {
          "crds": "CreateReplace",
          "remediation": {
            "retries": 3
          }
        },
        "interval": "10m",
        "releaseName": "gazelle-agent-platform",
        "serviceAccountName": "automation",
        "upgrade": {
          "crds": "CreateReplace",
          "remediation": {
            "retries": 3
          }
        },
        "values": {
          "components": {
            "agent-manager": {
              "enabled": false
            },
            "agent-platform-mcps": {
              "enabled": false
            },
            "agentgateway": {
              "enabled": false
            },
            "backstage": {
              "enabled": false
            },
            "dicebear": {
              "enabled": false
            },
            "flux": {
              "enabled": false
            },
            "kagent": {
              "enabled": false
            },
            "kagent-crds": {
              "enabled": false
            },
            "klaus-gateway": {
              "enabled": false
            },
            "kserve-llmisvc-crd": {
              "enabled": true
            },
            "kserve-llmisvc-resources": {
              "enabled": true
            },
            "kserve-runtime-configs": {
              "enabled": true
            },
            "mcp-kubernetes": {
              "enabled": false
            },
            "model-manager": {
              "enabled": false
            },
            "modelServing": {
              "enabled": true
            },
            "muster": {
              "enabled": false
            },
            "substrate": {
              "enabled": false
            },
            "substrate-crds": {
              "enabled": false
            },
            "valkey": {
              "enabled": false
            }
          },
          "gateway": {
            "jwksEgress": {
              "enabled": true,
              "namespace": "giantswarm",
              "port": 5556
            }
          },
          "gatewayApi": {
            "gateway": {
              "tls": {
                "secretName": "gazelle-wildcard-tls"
              }
            }
          },
          "gitops": {
            "target": {
              "kubeConfig": {
                "secretRef": {
                  "name": "gazelle-kubeconfig"
                }
              }
            }
          },
          "global": {
            "domain": "gazelle.example.io",
            "identity": {
              "clientId": "dex-k8s-authenticator",
              "existingSecret": "agent-platform-identity",
              "issuerUrl": "https://dex.gazelle.example.io"
            }
          },
          "modelServing": {
            "cache": {
              "enabled": false
            },
            "modelsGateway": {
              "enabled": true,
              "jwtAuthentication": {
                "jwks": {
                  "host": "dex.giantswarm.svc.cluster.local",
                  "port": 5556
                }
              }
            },
            "serving": {
              "runtimeClassName": "nvidia"
            }
          }
        }
      }
    }
  ],
  "gpuOperator": {
    "status": ""
  },
  "serving": {
    "status": "present",
    "provider": "cluster-manager",
    "evidence": [
      "HelmRelease org-giantswarm/gazelle-agent-platform"
    ]
  },
  "slice": {
    "name": "gazelle-agent-platform",
    "namespace": "org-giantswarm",
    "chartVersion": "4.44.1",
    "domain": "gazelle.example.io",
    "modelsHost": "models.gazelle.example.io",
    "jwks": "http://dex.giantswarm.svc.cluster.local:5556/keys"
  },
  "cacheClaims": [
    {
      "namespace": "model-serving",
      "name": "hf-cache",
      "phase": "Bound",
      "volume": "pvc-6e577f13-ff22-461c-a453-cfbcdd2d7c80",
      "zone": "eu-central-1b",
      "capacity": "500Gi",
      "capacityGiB": 500,
      "storageClass": "agent-platform-connectivity-hf-cache",
      "tier": {
        "type": "gp3",
        "iops": 3000,
        "throughputMiBps": 500
      },
      "tierSource": "storageClass",
      "reclaimPolicy": "Delete",
      "created": "2026-09-16T10:12:00Z",
      "price": {
        "monthlyUSD": 65.45,
        "source": "AWS EBS gp3 list price, EU (Frankfurt) (eu-central-1)",
        "asOf": "2026-09-19"
      },
      "mounted": true
    }
  ],
  "cache": {
    "enabled": false,
    "note": "the model cache of gazelle is removed: 1 claim(s) deleted — model-serving/hf-cache (500 GiB gp3 at 500 MiB/s, about $65.45 a month at list prices (AWS EBS gp3 list price, EU (Frankfurt) (eu-central-1), as of 2026-09-19)) — with their volumes under the class's Delete reclaim policy, and with them the cached weights and compiled graphs of every model served from them; the bill stops with the volume; the slice release org-giantswarm/gazelle-agent-platform is upgraded to modelServing.cache.enabled false, so the connectivity chart applies no claim again and every predictor of gazelle downloads its weights into its pod's ephemeral storage (the node's local disk) at each start — about 90 s more per cold start; a later create_node_pool or enable_model_serving with cache true creates the claim anew and is the slice's upgrade back to the cache"
  },
  "removedClaims": [
    {
      "namespace": "model-serving",
      "name": "hf-cache",
      "phase": "Bound",
      "volume": "pvc-6e577f13-ff22-461c-a453-cfbcdd2d7c80",
      "zone": "eu-central-1b",
      "capacity": "500Gi",
      "capacityGiB": 500,
      "storageClass": "agent-platform-connectivity-hf-cache",
      "tier": {
        "type": "gp3",
        "iops": 3000,
        "throughputMiBps": 500
      },
      "tierSource": "storageClass",
      "reclaimPolicy": "Delete",
      "created": "2026-09-16T10:12:00Z",
      "price": {
        "monthlyUSD": 65.45,
        "source": "AWS EBS gp3 list price, EU (Frankfurt) (eu-central-1)",
        "asOf": "2026-09-19"
      },
      "mounted": true
    }
  ]
}
