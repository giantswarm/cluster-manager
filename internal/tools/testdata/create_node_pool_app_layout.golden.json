  "machineImage": "flatcar-stable-4081.2.0-kube-1.30.8-tooling-1.26.0-gs",
  "objects": [
    {
      "apiVersion": "source.toolkit.fluxcd.io/v1",
      "kind": "OCIRepository",
      "name": "wc2-gpu-l4b",
      "namespace": "org-acme",
      "action": "would-create"
    },
    {
      "apiVersion": "helm.toolkit.fluxcd.io/v2",
      "kind": "HelmRelease",
      "name": "wc2-gpu-l4b",
      "namespace": "org-acme",
      "action": "would-create"
    }
  ],
  "manifests": [
    {
      "apiVersion": "source.toolkit.fluxcd.io/v1",
      "kind": "OCIRepository",
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "cluster-manager",
          "app.kubernetes.io/name": "gpu-node-pool",
          "giantswarm.io/cluster": "wc2",
          "giantswarm.io/node-pool": "gpu-l4b"
        },
        "name": "wc2-gpu-l4b",
        "namespace": "org-acme"
      },
      "spec": {
        "interval": "10m",
        "ref": {
          "tag": "0.3.0"
        },
        "url": "oci://gsoci.azurecr.io/charts/giantswarm/gpu-node-pool"
      }
    },
    {
      "apiVersion": "helm.toolkit.fluxcd.io/v2",
      "kind": "HelmRelease",
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "cluster-manager",
          "app.kubernetes.io/name": "gpu-node-pool",
          "giantswarm.io/cluster": "wc2",
          "giantswarm.io/node-pool": "gpu-l4b"
        },
        "name": "wc2-gpu-l4b",
        "namespace": "org-acme"
      },
      "spec": {
        "chartRef": {
          "kind": "OCIRepository",
          "name": "wc2-gpu-l4b"
        },
        "install": {
          "remediation": {
            "retries": 3
          }
        },
        "interval": "10m",
