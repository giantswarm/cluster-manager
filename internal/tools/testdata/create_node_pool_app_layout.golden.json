              "enabled": true,
              "httpProxy": "http://proxy.acme.example.io:3128",
              "httpsProxy": "http://proxy.acme.example.io:3128",
              "noProxy": "10.0.0.0/8,.acme.example.io"
            },
            "registryMirrors": {}
          },
          "pool": {
            "accelerator": "nvidia-l4",
            "kubernetesVersion": "1.30.8",
            "machineImage": "flatcar-stable-4081.2.0-kube-1.30.8-tooling-1.26.0-gs",
            "maxSize": {
              "nvidia.com/gpu": "4"
            },
            "name": "gpu-l4b"
          },
          "teleport": {
            "enabled": false
          }
        }
