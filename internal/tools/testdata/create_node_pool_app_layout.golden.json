{
  "cluster": "wc2",
  "namespace": "org-acme",
  "pool": "gpu-l4b",
  "mode": "apply",
  "dryRun": true,
  "chartVersion": "0.7.2",
  "kubernetesVersion": "1.30.8",
  "controlPlaneVersion": "v1.30.8",
  "machineImage": "flatcar-stable-4459.2.0-kube-1.30.8-tooling-1.26.0-gs",
  "objects": [
    {
      "apiVersion": "source.toolkit.fluxcd.io/v1",
      "kind": "OCIRepository",
      "name": "wc2-gpu-l4b",
      "namespace": "org-acme",
      "action": "would-create"
    },
    {
      "apiVersion": "helm.toolkit.fluxcd.io/v2",
      "kind": "HelmRelease",
      "name": "wc2-gpu-l4b",
      "namespace": "org-acme",
      "action": "would-create"
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "name": "model-backend-kserve",
      "namespace": "agent-platform",
      "action": "would-create"
    },
    {
      "apiVersion": "source.toolkit.fluxcd.io/v1",
      "kind": "OCIRepository",
      "name": "wc2-gpu-operator",
      "namespace": "org-acme",
      "action": "would-create"
    },
    {
      "apiVersion": "helm.toolkit.fluxcd.io/v2",
      "kind": "HelmRelease",
      "name": "wc2-gpu-operator",
      "namespace": "org-acme",
      "action": "would-create"
    }
  ],
  "manifests": [
    {
      "apiVersion": "source.toolkit.fluxcd.io/v1",
      "kind": "OCIRepository",
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "cluster-manager",
          "app.kubernetes.io/name": "gpu-node-pool",
          "giantswarm.io/cluster": "wc2",
          "giantswarm.io/node-pool": "gpu-l4b"
        },
        "name": "wc2-gpu-l4b",
        "namespace": "org-acme"
      },
      "spec": {
        "interval": "10m",
        "ref": {
          "tag": "0.7.2"
        },
        "url": "oci://gsoci.azurecr.io/charts/giantswarm/gpu-node-pool"
      }
    },
    {
      "apiVersion": "helm.toolkit.fluxcd.io/v2",
      "kind": "HelmRelease",
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "cluster-manager",
          "app.kubernetes.io/name": "gpu-node-pool",
          "giantswarm.io/cluster": "wc2",
          "giantswarm.io/node-pool": "gpu-l4b"
        },
        "name": "wc2-gpu-l4b",
        "namespace": "org-acme"
      },
      "spec": {
        "chartRef": {
          "kind": "OCIRepository",
          "name": "wc2-gpu-l4b"
        },
        "install": {
          "disableWaitForJobs": true,
          "remediation": {
            "retries": 3
          }
        },
        "interval": "10m",
        "releaseName": "wc2-gpu-l4b",
        "serviceAccountName": "automation",
        "uninstall": {
          "disableWait": true
        },
        "upgrade": {
          "disableWaitForJobs": true,
          "remediation": {
            "retries": 3
          }
        },
        "values": {
          "cluster": {
            "baseDomain": "acme.example.io",
            "managementCluster": "gazelle",
            "name": "wc2",
            "organization": "acme",
            "proxy": {
              "enabled": true,
              "httpProxy": "http://proxy.acme.example.io:3128",
              "httpsProxy": "http://proxy.acme.example.io:3128",
              "noProxy": "10.0.0.0/8,.acme.example.io"
            },
            "registryMirrors": {}
          },
          "pool": {
            "accelerator": "nvidia-l4",
            "kubernetesVersion": "1.30.8",
            "machineImage": "flatcar-stable-4459.2.0-kube-1.30.8-tooling-1.26.0-gs",
            "maxSize": {
              "nvidia.com/gpu": "4"
            },
            "name": "gpu-l4b"
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "data": {
        "backend.yaml": "apiVersion: agent-platform.giantswarm.io/v1alpha1\nkind: ModelBackend\nmetadata:\n  name: kserve\nspec:\n  kind: kserve\n  kserve:\n    discovery:\n      namespace: org-acme\n    gpuPool:\n      instances:\n      - gpuMemoryGiB: 24\n        gpus: 1\n        instanceType: g6.xlarge\n        memoryGiB: 16\n        size: xlarge\n        usableMemoryGiB: 11.9\n        usableVcpu: 3\n        vcpu: 4\n      - gpuMemoryGiB: 24\n        gpus: 1\n        instanceType: g6.2xlarge\n        memoryGiB: 32\n        size: 2xlarge\n        usableMemoryGiB: 27.1\n        usableVcpu: 7\n        vcpu: 8\n      - gpuMemoryGiB: 24\n        gpus: 1\n        instanceType: g6.4xlarge\n        memoryGiB: 64\n        size: 4xlarge\n        usableMemoryGiB: 57.5\n        usableVcpu: 15\n        vcpu: 16\n    target:\n      apiServer: https://api.wc2.acme.example.io:6443\n      caBundle: |\n        -----BEGIN CERTIFICATE-----\n        MIIBfixtureCAnotarealcertificate0000000000000000000000000000000000\n        -----END CERTIFICATE-----\n      cluster: wc2\n      organization: acme\n      servingNamespace: model-serving\n  source: cluster-manager\n"
      },
      "kind": "ConfigMap",
      "metadata": {
        "labels": {
          "agent-platform.giantswarm.io/model-backend": "true",
          "agent-platform.giantswarm.io/model-backend-source": "cluster-manager",
          "app.kubernetes.io/managed-by": "cluster-manager",
          "giantswarm.io/cluster": "wc2"
        },
        "name": "model-backend-kserve",
        "namespace": "agent-platform"
      }
    },
    {
      "apiVersion": "source.toolkit.fluxcd.io/v1",
      "kind": "OCIRepository",
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "cluster-manager",
          "app.kubernetes.io/name": "gpu-operator",
          "giantswarm.io/cluster": "wc2"
        },
        "name": "wc2-gpu-operator",
        "namespace": "org-acme"
      },
      "spec": {
        "interval": "10m",
        "ref": {
          "semver": "1.x"
        },
        "url": "oci://gsoci.azurecr.io/charts/giantswarm/gpu-operator"
      }
    },
    {
      "apiVersion": "helm.toolkit.fluxcd.io/v2",
      "kind": "HelmRelease",
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "cluster-manager",
          "app.kubernetes.io/name": "gpu-operator",
          "giantswarm.io/cluster": "wc2"
        },
        "name": "wc2-gpu-operator",
        "namespace": "org-acme"
      },
      "spec": {
        "chartRef": {
          "kind": "OCIRepository",
          "name": "wc2-gpu-operator"
        },
        "install": {
          "crds": "CreateReplace",
          "remediation": {
            "retries": 3
          }
        },
        "interval": "10m",
        "kubeConfig": {
          "secretRef": {
            "name": "wc2-kubeconfig"
          }
        },
        "releaseName": "gpu-operator",
        "storageNamespace": "kube-system",
        "targetNamespace": "kube-system",
        "upgrade": {
          "crds": "CreateReplace",
          "remediation": {
            "retries": 3
          }
        },
        "values": {
          "gpu-operator": {
            "daemonsets": {
              "tolerations": [
                {
                  "effect": "NoSchedule",
                  "key": "nvidia.com/gpu",
                  "operator": "Exists"
                },
                {
                  "key": "node.cluster.x-k8s.io/uninitialized",
                  "operator": "Exists"
                },
                {
                  "key": "ebs.csi.aws.com/agent-not-ready",
                  "operator": "Exists"
                }
              ]
            },
            "dcgmExporter": {
              "enabled": false
            },
            "driver": {
              "enabled": false
            },
            "migManager": {
              "enabled": false
            },
            "node-feature-discovery": {
              "worker": {
                "affinity": {
                  "nodeAffinity": {
                    "requiredDuringSchedulingIgnoredDuringExecution": {
                      "nodeSelectorTerms": [
                        {
                          "matchExpressions": [
                            {
                              "key": "giantswarm.io/machine-pool",
                              "operator": "In",
                              "values": [
                                "wc2-gpu-l4b"
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  }
                },
                "config": {
                  "core": {
                    "sleepInterval": "10s"
                  }
                },
                "tolerations": [
                  {
                    "effect": "NoSchedule",
                    "key": "node-role.kubernetes.io/control-plane",
                    "operator": "Equal",
                    "value": ""
                  },
                  {
                    "effect": "NoSchedule",
                    "key": "nvidia.com/gpu",
                    "operator": "Exists"
                  },
                  {
                    "key": "node.cluster.x-k8s.io/uninitialized",
                    "operator": "Exists"
                  },
                  {
                    "key": "ebs.csi.aws.com/agent-not-ready",
                    "operator": "Exists"
                  }
                ]
              }
            },
            "toolkit": {
              "enabled": true
            },
            "validator": {
              "cuda": {
                "env": [
                  {
                    "name": "WITH_WORKLOAD",
                    "value": "false"
                  }
                ]
              },
              "plugin": {
                "env": [
                  {
                    "name": "WITH_WORKLOAD",
                    "value": "false"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "gpuOperator": {
    "status": "absent"
  },
  "operatorRow": "pre-installed",
  "serving": {
    "status": "present",
    "provider": "chart",
    "evidence": [
      "discovery ConfigMap agent-platform/agent-platform-model-serving",
      "llmisvc API serving.kserve.io/v1alpha1 served"
    ]
  },
  "backend": {
    "kind": "kserve",
    "namespace": "agent-platform",
    "name": "model-backend-kserve",
    "target": "wc2 (https://api.wc2.acme.example.io:6443)"
  },
  "sizes": [
    {
      "instanceType": "g6.xlarge",
      "size": "xlarge",
      "vcpu": 4,
      "memoryGiB": 16,
      "gpus": 1,
      "gpuMemoryGiB": 24,
      "instanceStoreGB": 250,
      "instanceStoreDisks": 1,
      "instanceStoreDiskGB": 250,
      "usableVcpu": 3,
      "usableMemoryGiB": 11.9,
      "priceNote": "no on-demand price: AWS lists no on-demand g6.xlarge in EU (Ireland) (eu-west-1) — the size is not offered there"
    },
    {
      "instanceType": "g6.2xlarge",
      "size": "2xlarge",
      "vcpu": 8,
      "memoryGiB": 32,
      "gpus": 1,
      "gpuMemoryGiB": 24,
      "instanceStoreGB": 450,
      "instanceStoreDisks": 1,
      "instanceStoreDiskGB": 450,
      "usableVcpu": 7,
      "usableMemoryGiB": 27.1,
      "priceNote": "no on-demand price: AWS lists no on-demand g6.2xlarge in EU (Ireland) (eu-west-1) — the size is not offered there"
    },
    {
      "instanceType": "g6.4xlarge",
      "size": "4xlarge",
      "vcpu": 16,
      "memoryGiB": 64,
      "gpus": 1,
      "gpuMemoryGiB": 24,
      "instanceStoreGB": 600,
      "instanceStoreDisks": 1,
      "instanceStoreDiskGB": 600,
      "usableVcpu": 15,
      "usableMemoryGiB": 57.5,
      "priceNote": "no on-demand price: AWS lists no on-demand g6.4xlarge in EU (Ireland) (eu-west-1) — the size is not offered there"
    }
  ],
  "presetFit": {
    "origin": "published",
    "source": "3 preset ConfigMap(s) in agent-platform on wc2",
    "presets": [
      {
        "preset": "acme-l4-wide",
        "displayName": "Acme's wide L4 recipe",
        "model": "acme/wide-9b",
        "cpu": "4",
        "memory": "16Gi",
        "gpus": 1,
        "gpuMemoryGiB": 21,
        "size": "2xlarge"
      },
      {
        "preset": "qwen3-14b",
        "displayName": "Qwen3 14B",
        "model": "Qwen/Qwen3-14B",
        "cpu": "4",
        "memory": "48Gi",
        "gpus": 1,
        "gpuMemoryGiB": 58,
        "reason": "needs 58 GiB of GPU memory across 1 GPU(s); a g6 GPU has 24 GiB"
      },
      {
        "preset": "qwen3-4b-instruct",
        "displayName": "Qwen3 4B Instruct",
        "model": "Qwen/Qwen3-4B-Instruct-2507",
        "cpu": "2",
        "memory": "10Gi",
        "gpus": 1,
