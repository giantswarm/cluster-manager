{
  "cluster": "gazelle",
  "namespace": "org-giantswarm",
  "mode": "apply",
  "dryRun": true,
  "objects": [
    {
      "apiVersion": "source.toolkit.fluxcd.io/v1",
      "kind": "OCIRepository",
      "name": "gazelle-agent-platform",
      "namespace": "org-giantswarm",
      "action": "would-create"
    },
    {
      "apiVersion": "helm.toolkit.fluxcd.io/v2",
      "kind": "HelmRelease",
      "name": "gazelle-agent-platform",
      "namespace": "org-giantswarm",
      "action": "would-create"
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "name": "model-backend-kserve",
      "namespace": "agent-platform",
      "action": "would-create"
    }
  ],
  "manifests": [
    {
      "apiVersion": "source.toolkit.fluxcd.io/v1",
      "kind": "OCIRepository",
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "cluster-manager",
          "app.kubernetes.io/name": "agent-platform",
          "giantswarm.io/cluster": "gazelle"
        },
        "name": "gazelle-agent-platform",
        "namespace": "org-giantswarm"
      },
      "spec": {
        "interval": "10m",
        "ref": {
          "tag": "4.44.1"
        },
        "url": "oci://gsoci.azurecr.io/charts/giantswarm/agent-platform"
      }
    },
    {
      "apiVersion": "helm.toolkit.fluxcd.io/v2",
      "kind": "HelmRelease",
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "cluster-manager",
          "app.kubernetes.io/name": "agent-platform",
          "giantswarm.io/cluster": "gazelle"
        },
        "name": "gazelle-agent-platform",
        "namespace": "org-giantswarm"
      },
      "spec": {
        "chartRef": {
          "kind": "OCIRepository",
          "name": "gazelle-agent-platform"
        },
        "install": {
          "crds": "CreateReplace",
          "remediation": {
            "retries": 3
          }
        },
        "interval": "10m",
        "releaseName": "gazelle-agent-platform",
        "serviceAccountName": "automation",
        "upgrade": {
          "crds": "CreateReplace",
          "remediation": {
            "retries": 3
          }
        },
        "values": {
          "components": {
            "agent-manager": {
              "enabled": false
            },
            "agent-platform-mcps": {
              "enabled": false
            },
            "agentgateway": {
              "enabled": false
            },
            "backstage": {
              "enabled": false
            },
            "dicebear": {
              "enabled": false
            },
            "flux": {
              "enabled": false
            },
            "kagent": {
              "enabled": false
            },
            "kagent-crds": {
              "enabled": false
            },
            "klaus-gateway": {
              "enabled": false
            },
            "kserve-llmisvc-crd": {
              "enabled": true
            },
            "kserve-llmisvc-resources": {
              "enabled": true
            },
            "kserve-runtime-configs": {
              "enabled": true
            },
            "mcp-kubernetes": {
              "enabled": false
            },
            "model-manager": {
              "enabled": false
            },
            "modelServing": {
              "enabled": true
            },
            "muster": {
              "enabled": false
            },
            "substrate": {
              "enabled": false
            },
            "substrate-crds": {
              "enabled": false
            },
            "valkey": {
              "enabled": false
            }
          },
          "gateway": {
            "jwksEgress": {
              "enabled": true,
              "namespace": "giantswarm",
              "port": 5556
            }
          },
          "gatewayApi": {
            "gateway": {
              "tls": {
                "secretName": "gazelle-wildcard-tls"
              }
            }
          },
          "gitops": {
            "target": {
              "kubeConfig": {
                "secretRef": {
                  "name": "gazelle-kubeconfig"
                }
              }
            }
          },
          "global": {
            "domain": "gazelle.example.io",
            "identity": {
              "clientId": "dex-k8s-authenticator",
              "existingSecret": "agent-platform-identity",
              "issuerUrl": "https://dex.gazelle.example.io"
            }
          },
          "modelServing": {
            "modelsGateway": {
              "enabled": true,
              "jwtAuthentication": {
                "jwks": {
                  "host": "dex.giantswarm.svc.cluster.local",
                  "port": 5556
                }
              }
            },
            "networkPolicy": {
              "additionalIngressNamespaces": [
                "agent-platform",
                "ate-system"
              ]
            },
            "serving": {
              "runtimeClassName": "nvidia"
            }
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "data": {
        "backend.yaml": "apiVersion: agent-platform.giantswarm.io/v1alpha1\nkind: ModelBackend\nmetadata:\n  name: kserve\nspec:\n  kind: kserve\n  kserve:\n    discovery:\n      namespace: org-giantswarm\n    target:\n      cluster: local\n      organization: giantswarm\n      servingNamespace: model-serving\n  source: cluster-manager\n"
      },
      "kind": "ConfigMap",
      "metadata": {
        "labels": {
          "agent-platform.giantswarm.io/model-backend": "true",
          "agent-platform.giantswarm.io/model-backend-source": "cluster-manager",
          "app.kubernetes.io/managed-by": "cluster-manager",
          "giantswarm.io/cluster": "gazelle"
        },
        "name": "model-backend-kserve",
        "namespace": "agent-platform"
      }
    }
  ],
  "gpuOperator": {
    "status": ""
  },
  "serving": {
    "status": "absent"
  },
  "slice": {
    "name": "gazelle-agent-platform",
    "namespace": "org-giantswarm",
    "chartVersion": "4.44.1",
    "domain": "gazelle.example.io",
    "modelsHost": "models.gazelle.example.io",
    "jwks": "http://dex.giantswarm.svc.cluster.local:5556/keys"
  },
  "backend": {
    "kind": "kserve",
    "namespace": "agent-platform",
    "name": "model-backend-kserve",
    "target": "local"
  },
  "cache": {
    "enabled": true,
    "claim": "model-serving/hf-cache",
    "priceNote": "no price: the size and tier the connectivity chart creates the claim with could not be read (this server reads no chart registry)",
    "note": "the predictors mount the model cache claim model-serving/hf-cache — it does not exist yet: the connectivity chart creates it and keeps it (no price: the size and tier the connectivity chart creates the claim with could not be read (this server reads no chart registry)), billed from its first bind while the claim exists — after every pool of the cluster is removed too — until the cache is removed with remove_model_cache; the first predictor binds it to a volume in its node's zone; the weights and compiled graphs of every model served from this slice are kept there, and a pool created in the claim's zone with the cache on reuses it; the slice release is the cluster's one, so every predictor of the cluster mounts this claim from now on"
  }
}
