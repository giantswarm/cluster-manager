{
  "cluster": "dev01",
  "namespace": "org-acme",
  "mode": "apply",
  "dryRun": true,
  "release": "aws-36.0.0",
  "chartVersion": "36.0.0",
  "kubernetesVersion": "1.36.5",
  "objects": [
    {
      "apiVersion": "source.toolkit.fluxcd.io/v1",
      "kind": "OCIRepository",
      "name": "dev01",
      "namespace": "org-acme",
      "action": "would-create"
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "name": "dev01-values",
      "namespace": "org-acme",
      "action": "would-create"
    },
    {
      "apiVersion": "helm.toolkit.fluxcd.io/v2",
      "kind": "HelmRelease",
      "name": "dev01",
      "namespace": "org-acme",
      "action": "would-create"
    }
  ],
  "manifests": [
    {
      "apiVersion": "source.toolkit.fluxcd.io/v1",
      "kind": "OCIRepository",
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "cluster-manager",
          "app.kubernetes.io/name": "release-aws",
          "giantswarm.io/cluster": "dev01",
          "giantswarm.io/organization": "acme"
        },
        "name": "dev01",
        "namespace": "org-acme"
      },
      "spec": {
        "interval": "10m",
        "ref": {
          "tag": "36.0.0"
        },
        "url": "oci://gsoci.azurecr.io/charts/giantswarm/release-aws"
      }
    },
    {
      "apiVersion": "v1",
      "data": {
        "values.yaml": "global:\n  apps:\n    rbacBootstrap:\n      values:\n        bindings:\n        - groups:\n          - giantswarm-ad:giantswarm-admins\n          - giantswarm-ad:giantswarm:giantswarm-admins\n          - giantswarm-github:giantswarm:giantswarm-admins\n          - giantswarm-github:giantswarm-admins\n          role: view\n        - groups:\n          - customer:acme:Admins\n          role: cluster-admin\n  metadata:\n    description: Acme's development cluster\n    name: dev01\n    organization: acme\n  providerSpecific:\n    awsClusterRoleIdentityName: acme-dev\n  release:\n    version: 36.0.0\n"
      },
      "kind": "ConfigMap",
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "cluster-manager",
          "app.kubernetes.io/name": "release-aws",
          "giantswarm.io/cluster": "dev01",
          "giantswarm.io/organization": "acme"
        },
        "name": "dev01-values",
        "namespace": "org-acme"
      }
    },
    {
      "apiVersion": "helm.toolkit.fluxcd.io/v2",
      "kind": "HelmRelease",
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "cluster-manager",
          "app.kubernetes.io/name": "release-aws",
          "giantswarm.io/cluster": "dev01",
          "giantswarm.io/organization": "acme"
        },
        "name": "dev01",
        "namespace": "org-acme"
      },
      "spec": {
        "chartRef": {
          "kind": "OCIRepository",
          "name": "dev01"
        },
        "install": {
          "remediation": {
            "retries": 3
          }
        },
        "interval": "10m",
        "releaseName": "dev01",
        "serviceAccountName": "automation",
        "upgrade": {
          "remediation": {
            "retries": 3
          }
        },
        "valuesFrom": [
          {
            "kind": "ConfigMap",
            "name": "cluster-app-installation-values",
            "valuesKey": "values.yaml"
          },
          {
            "kind": "ConfigMap",
            "name": "dev01-values",
            "valuesKey": "values.yaml"
          }
        ]
      }
    }
  ],
  "gpuOperator": {
    "status": ""
  },
  "serving": {
    "status": ""
  },
  "oidc": {
    "source": "none",
    "note": "the cluster trusts no identity provider: this server knows no audience the installation's apiserver accepts, so calls to the cluster as you are refused as Unauthorized — pass global.controlPlane.oidc in values to name one"
  },
  "rbac": {
    "source": "composed",
    "role": "cluster-admin",
    "groups": [
      "customer:acme:Admins"
    ],
    "note": "this call runs without a signed-in person, so no creator is bound"
  }
}
