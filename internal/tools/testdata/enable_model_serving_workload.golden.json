      "apiVersion": "helm.toolkit.fluxcd.io/v2",
      "kind": "HelmRelease",
      "name": "wc1-agent-platform",
      "namespace": "org-acme",
      "action": "would-create"
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "name": "model-backend-kserve",
      "namespace": "agent-platform",
      "action": "would-create"
    }
  ],
  "manifests": [
    {
      "apiVersion": "source.toolkit.fluxcd.io/v1",
      "kind": "OCIRepository",
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "cluster-manager",
          "app.kubernetes.io/name": "agent-platform",
          "giantswarm.io/cluster": "wc1"
        },
        "name": "wc1-agent-platform",
        "namespace": "org-acme",
        "ownerReferences": [
          {
            "apiVersion": "cluster.x-k8s.io/v1beta1",
            "kind": "Cluster",
            "name": "wc1",
            "uid": "6f1c0c1e-8a4a-4c1e-9c3a-000000000001"
          }
        ]
      },
      "spec": {
        "interval": "10m",
        "ref": {
          "tag": "4.27.2"
        },
        "url": "oci://gsoci.azurecr.io/charts/giantswarm/agent-platform"
      }
    },
    {
      "apiVersion": "helm.toolkit.fluxcd.io/v2",
      "kind": "HelmRelease",
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "cluster-manager",
          "app.kubernetes.io/name": "agent-platform",
          "giantswarm.io/cluster": "wc1"
        },
        "name": "wc1-agent-platform",
        "namespace": "org-acme",
        "ownerReferences": [
          {
            "apiVersion": "cluster.x-k8s.io/v1beta1",
            "kind": "Cluster",
            "name": "wc1",
            "uid": "6f1c0c1e-8a4a-4c1e-9c3a-000000000001"
          }
        ]
      },
      "spec": {
        "chartRef": {
          "kind": "OCIRepository",
          "name": "wc1-agent-platform"
        },
        "install": {
          "crds": "CreateReplace",
          "remediation": {
            "retries": 3
          }
        },
        "interval": "10m",
        "releaseName": "wc1-agent-platform",
        "serviceAccountName": "automation",
        "upgrade": {
          "crds": "CreateReplace",
          "remediation": {
            "retries": 3
          }
        },
        "values": {
          "components": {
            "agent-manager": {
              "enabled": false
            },
            "agent-platform-mcps": {
              "enabled": false
            },
            "agentgateway": {
              "enabled": true
            },
            "backstage": {
              "enabled": false
            },
            "dicebear": {
              "enabled": false
            },
            "flux": {
              "enabled": false
            },
            "kagent": {
              "enabled": false
            },
            "kagent-crds": {
              "enabled": false
            },
            "klaus-gateway": {
              "enabled": false
            },
            "kserve-crd": {
              "enabled": true
            },
            "kserve-llmisvc-crd": {
              "enabled": true
            },
            "kserve-llmisvc-resources": {
              "enabled": true
            },
            "kserve-resources": {
              "enabled": true
            },
            "kserve-runtime-configs": {
              "enabled": true
            },
            "mcp-kubernetes": {
              "enabled": false
            },
            "model-manager": {
              "enabled": false
            },
            "modelServing": {
              "enabled": true
            },
            "muster": {
              "enabled": false
            },
            "substrate": {
              "enabled": false
            },
            "substrate-crds": {
              "enabled": false
            },
            "valkey": {
              "enabled": false
            }
          },
          "gitops": {
            "target": {
              "kubeConfig": {
                "secretRef": {
                  "name": "wc1-kubeconfig"
                }
              }
            }
          },
          "global": {
            "domain": "wc1.acme.example.io",
            "identity": {
              "clientId": "dex-k8s-authenticator",
              "existingSecret": "agent-platform-identity",
              "issuerUrl": "https://dex.gazelle.example.io"
            }
          },
          "modelServing": {
            "gpuPool": {
              "nodeSelector": {
                "giantswarm.io/machine-pool": "wc1-gpu-a10g"
              }
            },
            "modelsGateway": {
              "enabled": true,
              "tls": {
                "issuerRef": {
                  "name": "letsencrypt-giantswarm"
                }
              }
            },
            "serving": {
              "nodeSelector": {
                "giantswarm.io/machine-pool": "wc1-gpu-a10g"
              },
              "runtimeClassName": "nvidia"
            }
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "data": {
        "backend.yaml": "apiVersion: agent-platform.giantswarm.io/v1alpha1\nkind: ModelBackend\nmetadata:\n  name: kserve\nspec:\n  kind: kserve\n  kserve:\n    discovery:\n      namespace: org-acme\n    gpuPool:\n      instances:\n      - gpuMemoryGiB: 24\n        gpus: 1\n        instanceType: g5.xlarge\n        memoryGiB: 16\n        size: xlarge\n        usableMemoryGiB: 11.9\n        usableVcpu: 3\n        vcpu: 4\n      - gpuMemoryGiB: 24\n        gpus: 1\n        instanceType: g5.2xlarge\n        memoryGiB: 32\n        size: 2xlarge\n        usableMemoryGiB: 27.1\n        usableVcpu: 7\n        vcpu: 8\n      - gpuMemoryGiB: 24\n        gpus: 1\n        instanceType: g5.4xlarge\n        memoryGiB: 64\n        size: 4xlarge\n        usableMemoryGiB: 57.5\n        usableVcpu: 15\n        vcpu: 16\n    target:\n      apiServer: https://api.wc1.acme.example.io:6443\n      caBundle: |\n        -----BEGIN CERTIFICATE-----\n        MIIBfixtureCAnotarealcertificate0000000000000000000000000000000000\n        -----END CERTIFICATE-----\n      cluster: wc1\n      organization: acme\n      servingNamespace: model-serving\n  source: cluster-manager\n"
      },
      "kind": "ConfigMap",
      "metadata": {
        "labels": {
          "agent-platform.giantswarm.io/model-backend": "true",
          "agent-platform.giantswarm.io/model-backend-source": "cluster-manager",
          "app.kubernetes.io/managed-by": "cluster-manager",
          "giantswarm.io/cluster": "wc1"
        },
        "name": "model-backend-kserve",
        "namespace": "agent-platform"
      }
    }
  ],
  "gpuOperator": {
    "status": ""
  },
  "serving": {
    "status": "absent"
  },
  "slice": {
    "name": "wc1-agent-platform",
    "namespace": "org-acme",
    "chartVersion": "4.27.2",
    "domain": "wc1.acme.example.io",
    "modelsHost": "models.wc1.acme.example.io",
    "gpuPool": "gpu-a10g"
  },
  "backend": {
    "kind": "kserve",
    "namespace": "agent-platform",
    "name": "model-backend-kserve",
    "target": "wc1 (https://api.wc1.acme.example.io:6443)"
  }
}
