{
  "cluster": "wc1",
  "namespace": "org-acme",
  "mode": "apply",
  "dryRun": true,
  "objects": [
    {
      "apiVersion": "source.toolkit.fluxcd.io/v1",
      "kind": "OCIRepository",
      "name": "wc1-agent-platform",
      "namespace": "org-acme",
      "action": "would-create"
