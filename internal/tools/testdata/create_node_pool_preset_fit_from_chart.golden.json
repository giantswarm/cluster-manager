            "retries": 3
          }
        },
        "values": {
          "gpu-operator": {
            "daemonsets": {
              "tolerations": [
                {
                  "effect": "NoSchedule",
                  "key": "nvidia.com/gpu",
                  "operator": "Exists"
                },
                {
                  "key": "node.cluster.x-k8s.io/uninitialized",
                  "operator": "Exists"
                },
                {
                  "key": "ebs.csi.aws.com/agent-not-ready",
                  "operator": "Exists"
                }
              ]
            },
            "dcgmExporter": {
              "enabled": false
            },
            "driver": {
              "enabled": false
            },
            "migManager": {
              "enabled": false
            },
            "node-feature-discovery": {
              "worker": {
                "affinity": {
                  "nodeAffinity": {
                    "requiredDuringSchedulingIgnoredDuringExecution": {
                      "nodeSelectorTerms": [
                        {
                          "matchExpressions": [
                            {
                              "key": "giantswarm.io/machine-pool",
                              "operator": "In",
                              "values": [
                                "wc1-gpu-a10g",
                                "wc1-gpu-l4"
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  }
                },
                "config": {
                  "core": {
                    "sleepInterval": "10s"
                  }
                },
                "tolerations": [
                  {
                    "effect": "NoSchedule",
                    "key": "node-role.kubernetes.io/control-plane",
                    "operator": "Equal",
                    "value": ""
                  },
                  {
                    "effect": "NoSchedule",
                    "key": "nvidia.com/gpu",
                    "operator": "Exists"
                  },
                  {
                    "key": "node.cluster.x-k8s.io/uninitialized",
                    "operator": "Exists"
                  },
                  {
                    "key": "ebs.csi.aws.com/agent-not-ready",
                    "operator": "Exists"
                  }
                ]
              }
            },
            "toolkit": {
              "enabled": false
            },
            "validator": {
              "cuda": {
                "env": [
                  {
                    "name": "WITH_WORKLOAD",
                    "value": "false"
                  }
                ]
              },
              "plugin": {
                "env": [
                  {
                    "name": "WITH_WORKLOAD",
                    "value": "false"
                  }
                ]
              }
            }
          }
        }
      }
